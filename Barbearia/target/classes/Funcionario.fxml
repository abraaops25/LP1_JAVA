<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="480.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.BarbeariaController">
    <children>
        <Label layoutX="20.0" layoutY="20.0" text="Cadastrar Funcionário"><font><Font name="Arial Black" size="20.0"/></font></Label>
        <Label layoutX="20.0" layoutY="75.0" text="Nome:"/>
        <TextField fx:id="campoNomeFuncionario" layoutX="160.0" layoutY="70.0" prefWidth="250.0"/>
        <Label layoutX="20.0" layoutY="115.0" text="Telefone:"/>
        <TextField fx:id="campoTelefoneFuncionario" layoutX="160.0" layoutY="110.0" prefWidth="250.0"/>
        <Label layoutX="20.0" layoutY="155.0" text="Especialidade:"/>
        <TextField fx:id="campoEspecialidade" layoutX="160.0" layoutY="150.0" prefWidth="250.0"/>
        <Label layoutX="20.0" layoutY="195.0" text="Comissão (%):"/>
        <TextField fx:id="campoComissao" layoutX="160.0" layoutY="190.0" prefWidth="250.0"/>
        <Button layoutX="160.0" layoutY="240.0" prefWidth="120.0" text="Salvar" onAction="#salvarFuncionario"/>
        <Button layoutX="295.0" layoutY="240.0" prefWidth="120.0" text="Limpar" onAction="#limparCamposFuncionario"/>
        <Label fx:id="mensagemFuncionario" layoutX="160.0" layoutY="285.0" prefWidth="300.0"/>
        <Label layoutX="430.0" layoutY="20.0" text="Funcionários:"><font><Font name="Arial Black" size="11.0"/></font></Label>
        <ListView fx:id="listaGeral" layoutX="430.0" layoutY="40.0" prefWidth="200.0" prefHeight="350.0"/>
        <Button layoutX="430.0" layoutY="400.0" prefWidth="200.0" text="Atualizar" onAction="#verFuncionarios"/>
        <Button layoutX="20.0" layoutY="430.0" prefWidth="130.0" text="Menu" onAction="#BotaoMenu"/>
        <Button layoutX="160.0" layoutY="430.0" prefWidth="130.0" text="Clientes" onAction="#BotaoCliente"/>
        <Button layoutX="300.0" layoutY="430.0" prefWidth="120.0" text="Serviços" onAction="#BotaoServico"/>
    </children>
</AnchorPane>
