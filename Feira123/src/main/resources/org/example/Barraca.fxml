<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="480.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.Controller.FeiraController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Cadastrar Barraca">
         <font><Font name="Arial Black" size="20.0"/></font>
      </Label>

      <Label layoutX="20.0" layoutY="75.0" text="Nome:"/>
      <TextField fx:id="campoNomeBarraca" layoutX="120.0" layoutY="70.0" prefWidth="250.0"/>

      <Label layoutX="20.0" layoutY="115.0" text="Numero:"/>
      <TextField fx:id="campoNumero" layoutX="120.0" layoutY="110.0" prefWidth="250.0"/>

      <Label layoutX="20.0" layoutY="155.0" text="Feira:"/>
      <ComboBox fx:id="campoFeiraDaBarraca" layoutX="120.0" layoutY="150.0" prefWidth="250.0"/>

      <Button layoutX="120.0" layoutY="210.0" prefWidth="120.0" text="Salvar"
              onAction="#salvarBarraca"/>
      <Button layoutX="255.0" layoutY="210.0" prefWidth="120.0" text="Limpar"
              onAction="#limparCamposBarraca"/>

      <Label fx:id="mensagemBarraca" layoutX="120.0" layoutY="255.0" prefWidth="250.0"/>

      <Label layoutX="400.0" layoutY="20.0" text="Barracas cadastradas:">
         <font><Font name="Arial Black" size="11.0"/></font>
      </Label>
      <ListView fx:id="listaGeral" layoutX="400.0" layoutY="45.0"
                prefWidth="230.0" prefHeight="340.0"/>
      <Button layoutX="400.0" layoutY="395.0" prefWidth="230.0" text="Atualizar Lista"
              onAction="#verBarracas"/>

      <Button layoutX="20.0" layoutY="430.0" prefWidth="150.0" text="Menu Principal"
              onAction="#BotaoMenu"/>
      <Button layoutX="180.0" layoutY="430.0" prefWidth="150.0" text="Ir para Frutas"
              onAction="#BotaoFruta"/>
      <Button layoutX="340.0" layoutY="430.0" prefWidth="150.0" text="Ir para Pessoas"
              onAction="#BotaoPessoas"/>
   </children>
</AnchorPane>