<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.Controller.FeiraController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Cadastrar Feira">
         <font><Font name="Arial Black" size="22.0"/></font>
      </Label>

      <Label layoutX="20.0" layoutY="80.0" text="Nome:"/>
      <TextField fx:id="campoNomeFeira" layoutX="120.0" layoutY="75.0" prefWidth="300.0"/>

      <Label layoutX="20.0" layoutY="130.0" text="Dia da Semana:"/>
      <ComboBox fx:id="campoDia" layoutX="120.0" layoutY="125.0" prefWidth="300.0"/>

      <Label layoutX="20.0" layoutY="180.0" text="Endereço:"/>
      <TextField fx:id="campoEndereco" layoutX="120.0" layoutY="175.0" prefWidth="300.0"/>

      <Button layoutX="120.0" layoutY="240.0" prefWidth="140.0" text="Salvar Feira"
              onAction="#salvarFeira"/>
      <Button layoutX="280.0" layoutY="240.0" prefWidth="140.0" text="Limpar"
              onAction="#limparCamposFeira"/>

      <Label fx:id="mensagemFeira" layoutX="120.0" layoutY="290.0" prefWidth="300.0" textFill="green"/>

      <Button layoutX="20.0" layoutY="350.0" text="← Voltar" onAction="#BotaoVoltar"/>
   </children>
</AnchorPane>