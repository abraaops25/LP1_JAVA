<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="560.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.Controller.FarmaciaController">
    <children>

        <Label layoutX="20.0" layoutY="15.0" text="Todos os Cadastros">
            <font><Font name="Arial Black" size="20.0"/></font>
        </Label>

        <!-- Farmácias -->
        <Label layoutX="20.0" layoutY="55.0" text="🏥 Farmácias:">
            <font><Font name="Arial Black" size="11.0"/></font>
        </Label>
        <ListView fx:id="listaTodasFarmacias" layoutX="20.0" layoutY="75.0"
                  prefWidth="310.0" prefHeight="100.0"/>

        <!-- Prateleiras -->
        <Label layoutX="360.0" layoutY="55.0" text="🗄️ Prateleiras:">
            <font><Font name="Arial Black" size="11.0"/></font>
        </Label>
        <ListView fx:id="listaTodasPrateleiras" layoutX="360.0" layoutY="75.0"
                  prefWidth="310.0" prefHeight="100.0"/>

        <!-- Remédios -->
        <Label layoutX="20.0" layoutY="195.0" text="💊 Remédios:">
            <font><Font name="Arial Black" size="11.0"/></font>
        </Label>
        <ListView fx:id="listaTodosRemedios" layoutX="20.0" layoutY="215.0"
                  prefWidth="310.0" prefHeight="130.0"/>

        <!-- Clientes -->
        <Label layoutX="360.0" layoutY="195.0" text="👤 Clientes:">
            <font><Font name="Arial Black" size="11.0"/></font>
        </Label>
        <ListView fx:id="listaTodosClientes" layoutX="360.0" layoutY="215.0"
                  prefWidth="310.0" prefHeight="130.0"/>

        <Button layoutX="20.0" layoutY="370.0" prefWidth="660.0" text="Atualizar Tudo"
                onAction="#carregarTodos"/>

        <Separator layoutX="20.0" layoutY="410.0" prefWidth="660.0"/>

        <Button layoutX="20.0" layoutY="425.0" prefWidth="660.0" prefHeight="40.0"
                text="Voltar ao Menu Principal" onAction="#BotaoMenu"/>

    </children>
</AnchorPane>
