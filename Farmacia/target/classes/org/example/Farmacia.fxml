<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.Controller.FarmaciaController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Cadastrar Farmácia">
         <font><Font name="Arial Black" size="20.0"/></font>
      </Label>

      <Label layoutX="20.0" layoutY="80.0" text="Nome:"/>
      <TextField fx:id="campoNomeFarmacia" layoutX="140.0" layoutY="75.0" prefWidth="250.0"/>

      <Label layoutX="20.0" layoutY="120.0" text="CNPJ:"/>
      <TextField fx:id="campoCnpj" layoutX="140.0" layoutY="115.0" prefWidth="250.0"/>

      <Label layoutX="20.0" layoutY="160.0" text="Endereço:"/>
      <TextField fx:id="campoEndereco" layoutX="140.0" layoutY="155.0" prefWidth="250.0"/>

      <Button layoutX="140.0" layoutY="210.0" prefWidth="120.0" text="Salvar"
              onAction="#salvarFarmacia"/>
      <Button layoutX="275.0" layoutY="210.0" prefWidth="120.0" text="Limpar"
              onAction="#limparCamposFarmacia"/>

      <Label fx:id="mensagemFarmacia" layoutX="140.0" layoutY="255.0" prefWidth="300.0"/>
   </children>
</AnchorPane>
