<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="480.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.Controller.FarmaciaController">
   <children>
      <Label layoutX="20.0" layoutY="20.0" text="Cadastrar Remédio">
         <font><Font name="Arial Black" size="20.0"/></font>
      </Label>

      <Label layoutX="20.0" layoutY="75.0" text="Nome:"/>
      <TextField fx:id="campoNomeRemedio" layoutX="140.0" layoutY="70.0" prefWidth="250.0"/>

      <Label layoutX="20.0" layoutY="115.0" text="Tipo:"/>
      <TextField fx:id="campoTipo" layoutX="140.0" layoutY="110.0" prefWidth="250.0"/>

      <Label layoutX="20.0" layoutY="155.0" text="Validade:"/>
      <TextField fx:id="campoValidade" layoutX="140.0" layoutY="150.0" prefWidth="250.0"
                 promptText="dd/MM/yyyy"/>

      <Label layoutX="20.0" layoutY="195.0" text="Preço (R$):"/>
      <TextField fx:id="campoPreco" layoutX="140.0" layoutY="190.0" prefWidth="250.0"/>

      <Label layoutX="20.0" layoutY="235.0" text="Prateleira:"/>
      <ComboBox fx:id="campoPrateleiraDoRemedio" layoutX="140.0" layoutY="230.0" prefWidth="250.0"/>

      <Button layoutX="140.0" layoutY="280.0" prefWidth="120.0" text="Salvar"
              onAction="#salvarRemedio"/>
      <Button layoutX="275.0" layoutY="280.0" prefWidth="120.0" text="Limpar"
              onAction="#limparCamposRemedio"/>

      <Label fx:id="mensagemRemedio" layoutX="140.0" layoutY="325.0" prefWidth="300.0"/>

      <Label layoutX="420.0" layoutY="20.0" text="Remédios cadastrados:">
         <font><Font name="Arial Black" size="11.0"/></font>
      </Label>
      <ListView fx:id="listaGeral" layoutX="420.0" layoutY="45.0"
                prefWidth="210.0" prefHeight="340.0"/>
      <Button layoutX="420.0" layoutY="395.0" prefWidth="210.0" text="Atualizar Lista"
              onAction="#verRemedios"/>

      <Button layoutX="20.0" layoutY="430.0" prefWidth="150.0" text="Menu Principal"
              onAction="#BotaoMenu"/>
      <Button layoutX="180.0" layoutY="430.0" prefWidth="150.0" text="Ir para Prateleiras"
              onAction="#BotaoPrateleira"/>
      <Button layoutX="340.0" layoutY="430.0" prefWidth="150.0" text="Ir para Clientes"
              onAction="#BotaoCliente"/>
   </children>
</AnchorPane>
